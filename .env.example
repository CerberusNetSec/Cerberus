# Copy to .env (which is git-ignored) and edit. docker compose reads it automatically.

# Dashboard password. If unset, one is generated and printed once in `docker logs cerberus`.
CERBERUS_PASSWORD=change-me

# Base URL used for links in notifications.
CERBERUS_PUBLIC_URL=http://192.0.2.10:8080

# Docker Desktop (Windows/macOS) and rootless Docker hide each device's source address.
# There, identify devices by the hostname in their syslog header instead:
# CERBERUS_DEVICE_IDENTITY=hostname

# Time zone for the container's logs.
TZ=UTC
